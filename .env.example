# Copy this file to .env and fill in your values. Never commit .env.

# --- Azure OpenAI (required) ---
# e.g. https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# e.g. 2024-10-21
AZURE_OPENAI_API_VERSION=
# The *deployment* name you chose in Azure AI Foundry (backed by gpt-4.1 or gpt-4.1-mini)
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Optional tuning ---
# faster-whisper model: tiny.en | base.en | small.en | medium.en  (bigger = more accurate, slower)
WHISPER_MODEL=base.en
# int8 is the fastest CPU option
WHISPER_COMPUTE_TYPE=int8
# auto | moviepy | ffmpeg
VIDEO_BACKEND=auto

# Fingerspelling fallback for words without a sign clip (needs clips/alphabet/A.mp4..Z.mp4)
FINGERSPELL=1
FINGERSPELL_SPEED=1.5
